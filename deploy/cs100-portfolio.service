[Unit]
Description=CS100 Portfolio App
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/GROUP-TERM-PROJECT
Environment=PORT=3000
# Check the real path with: which node
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
